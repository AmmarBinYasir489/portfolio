---
import Layout from '../layouts/Layout.astro';
const projects = [
  ['01','AI Research Assistant','Agentic research that discovers sources, evaluates evidence, and produces cited summaries.','Python · FastAPI · Ollama · Gemini','SOURCE → EVALUATE → SYNTHESIZE','https://github.com/AmmarBinYasir489/ai-research-assistant','RESEARCH AGENT','/projects/research-assistant.png'],
  ['02','Nourish AI','A multimodal nutrition companion that understands meal images and creates reusable food templates.','Next.js · Supabase · Gemini Vision','VISION → ANALYZE → TRACK','https://github.com/AmmarBinYasir489/calories-counter','MULTIMODAL PRODUCT','/projects/nourish-ai.png'],
  ['03','Expense AI','Natural-language expense capture, financial analytics, and conversational insight in one product.','Next.js · TypeScript · Supabase','CAPTURE → CLASSIFY → INSIGHT','https://github.com/AmmarBinYasir489/expense-ai','FINANCE PLATFORM','/projects/expense-ai.png'],
  ['04','Grounded Workspace','A private document environment for source-aware answers across internal knowledge.','TypeScript · RAG · AI Search','INGEST → RETRIEVE → ANSWER','https://github.com/AmmarBinYasir489/grounded-knowledge-workspace','KNOWLEDGE SYSTEM','/projects/grounded-workspace.png'],
  ['05','Recruiter Portal','A recruiter-facing hiring workspace for managing openings, reviewing resumes, tracking applicants, comparing candidates, and monitoring pipeline performance.','Full-Stack · Role-Based UI · Hiring Analytics','POST → REVIEW → SHORTLIST → HIRE','','RECRUITMENT PLATFORM','/projects/recruiter-portal.png'],
];
const tech = ['OpenAI','Gemini','n8n','Python','FastAPI','Next.js','TypeScript','Supabase','PostgreSQL','RAG'];
---
<Layout title="Ammar Bin Yasir — AI Automation Engineer" description="AI Automation Engineer building AI agents, intelligent workflows, LLM applications, and production-ready full-stack AI systems.">
  <a class="skip" href="#main">Skip to content</a>
  <div id="boot"><b>ABY<span>/</span>SYS</b><div><i></i></div><small>INITIALIZING CORE <em id="count">000</em></small></div>
  <div class="grain" aria-hidden="true"></div><div id="cursor" aria-hidden="true"></div><div id="project-cursor" aria-hidden="true">VIEW</div>
  <header>
    <a class="brand" href="#main"><b>A</b><span>AMMAR<br/>BIN YASIR</span></a>
    <nav><a href="#projects">Projects</a><a href="#profile">Profile</a><a href="#stack">Stack</a></nav>
    <a class="status" href="#contact"><i></i>Connection ready</a>
  </header>
  <main id="main">
    <section class="hero scene" data-scene="hero">
      <span class="rail">01 / INITIALIZE</span>
      <div class="hero-copy">
        <p class="eyebrow"><i></i>AI ENGINEER · AUTOMATION SPECIALIST · SYSTEM ONLINE</p>
        <h1><span>ENGINEERING</span><span class="outline">INTELLIGENT</span><span>SYSTEMS<em>.</em></span></h1>
        <p class="intro">I’m Ammar Bin Yasir. I build AI agents, connected automations, and full-stack products that turn operational friction into clear, reliable systems.</p>
        <div class="actions"><a class="cta" href="#projects">ENTER THE LAB <b>↓</b></a><a href="https://github.com/AmmarBinYasir489" target="_blank" rel="noreferrer">GITHUB / 489 ↗</a></div>
      </div>
      <div class="signal-composition" aria-hidden="true"><canvas id="flow-field"></canvas><span>AI</span><span>AUTOMATION</span><span>ENGINEERING</span><div><i></i><i></i><i></i><i></i><i></i></div><small>THREE.JS DATA FLOW / LIVE</small></div>
      <aside><div>CORE_PROFILE.JSON <i></i></div><dl><dt>ROLE</dt><dd>AI ENGINEER</dd><dt>FOCUS</dt><dd>AGENTS · AUTOMATION</dd><dt>BUILD</dt><dd>LLM · FULL-STACK · API</dd><dt>STATUS</dt><dd class="red">AVAILABLE</dd></dl></aside>
      <p class="scroll">SCROLL TO EXPLORE <i></i></p>
    </section>

    <div class="signal-strip" aria-label="Core disciplines"><span>AI AGENTS</span><i></i><span>WORKFLOW AUTOMATION</span><i></i><span>FULL-STACK PRODUCTS</span><i></i><span>API INTEGRATION</span><i></i><span>WEB · WORDPRESS · SEO</span></div>

    <section class="manifesto scene" data-scene="manifesto">
      <span class="rail">02 / SIGNAL</span><h2>NOT MORE SOFTWARE.</h2><h2 class="outline">BETTER SYSTEMS.</h2>
      <p>AI AGENTS <i></i> WORKFLOW AUTOMATION <i></i> FULL-STACK AI</p>
    </section>

    <section id="projects" class="projects scene" data-scene="projects">
      <div class="section-head"><span class="rail">03 / PROJECT SPACE</span><div><p class="eyebrow"><i></i>SELECTED BUILDS</p><h2>PROOF IN<br/><em>MOTION.</em></h2></div><p>Five production-minded builds presented as a spatial evidence wall—idea, operating flow, and engineering layer in one view.</p></div>
      <div class="project-space">
        <nav class="project-dock" aria-label="Project index"><small>QUICK ACCESS</small>{projects.map((p,i)=><a href={`#project-${i+1}`}><b>{p[0]}</b><span>{p[1]}</span></a>)}</nav>
        <div class="deck">
          {projects.map((p,i)=><article class="project" data-project={i} id={`project-${i+1}`}>
            <div class="project-top"><span>PROJECT {p[0]} / 05</span><span>{p[6]}</span><span>{p[5] ? 'GITHUB LINKED' : 'CASE STUDY'}</span></div>
            <div class="project-body">
              <div class="visual"><img src={p[7]} width="1536" height="864" loading="lazy" alt={`${p[1]} interface concept`}/><span class="image-scan"></span><small>{p[4]}</small></div>
              <div class="project-copy"><p class="eyebrow"><i></i>{p[6]}</p><h3>{p[1]}</h3><p>{p[2]}</p><small>{p[3]}</small>{p[5] ? <a href={p[5]} target="_blank" rel="noreferrer">VIEW ON GITHUB <b>↗</b></a> : <button class="detail-trigger" data-dialog="recruiter-detail">VIEW CASE STUDY <b>＋</b></button>}</div>
            </div>
            {p[5] ? <a class="project-hit" href={p[5]} target="_blank" rel="noreferrer" aria-label={`Open ${p[1]} on GitHub`}></a> : <button class="project-hit detail-trigger" data-dialog="recruiter-detail" aria-label="Open Recruiter Portal case study"></button>}
          </article>)}
        </div>
      </div>
    </section>

    <dialog id="recruiter-detail" class="project-dialog" aria-labelledby="recruiter-title">
      <button class="dialog-close" aria-label="Close project details">×</button>
      <div class="dialog-media"><img src="/projects/recruiter-portal.png" width="1536" height="864" alt="Recruiter Portal interface concept"/></div>
      <div class="dialog-copy"><p class="eyebrow"><i></i>PROJECT 05 · CASE STUDY</p><h2 id="recruiter-title">RECRUITER<br/><em>PORTAL.</em></h2><p>A full-stack recruitment workspace designed around the daily hiring workflow—from publishing roles to reviewing candidates and moving applicants through a clear pipeline.</p><ul><li>Role and job-post management</li><li>Applicant pipeline and status tracking</li><li>Resume review and candidate comparison</li><li>Shortlisting workflow and hiring analytics</li><li>Responsive recruiter dashboard</li></ul><small>Repository link will appear here when the project is published on GitHub.</small></div>
    </dialog>

    <section id="profile" class="profile scene" data-scene="profile">
      <div class="section-head compact"><span class="rail">04 / OPERATOR</span><div><p class="eyebrow"><i></i>PROFILE</p><h2>ENGINEER.<br/><em>BUILDER.</em><br/>SYSTEMS THINKER.</h2></div></div>
      <div class="profile-grid">
        <figure><div class="corners"></div><img src="/ammar-portrait-cutout.png" width="768" height="1365" alt="Portrait of Ammar Bin Yasir"/><figcaption><span>SUBJECT / AMMAR</span><span>IDENTITY VERIFIED</span></figcaption></figure>
        <div class="bio"><p>I work across the complete product journey—from mapping an operational problem to engineering the AI layer, interface, integrations, and deployment.</p><p>My profile is intentionally broader than one AI pattern: agents, automations, APIs, full-stack products, web development, WordPress, and technical SEO where the product needs them.</p><div class="profile-signals"><span><b>AI</b>ENGINEERING</span><span><b>API</b>INTEGRATION</span><span><b>WEB</b>PRODUCTS</span></div><dl><dt>DISCIPLINE</dt><dd>AI ENGINEERING</dd><dt>MODE</dt><dd>BUILD → TEST → REFINE</dd><dt>LOCATION</dt><dd>PAKISTAN / REMOTE</dd></dl></div>
      </div>
    </section>

    <section id="stack" class="stack scene" data-scene="stack">
      <div><span class="rail">05 / CONSTELLATION</span><p class="eyebrow"><i></i>TECHNOLOGY FIELD</p><h2>TOOLS THAT<br/><em>CONNECT.</em></h2><p>The stack changes with the system. The constant is the connection between intelligence, automation, interface, and infrastructure.</p></div>
      <div class="constellation"><svg viewBox="0 0 1000 700" preserveAspectRatio="none"><path d="M500 350L100 100M500 350L720 70M500 350L450 180M500 350L170 340M500 350L790 300M500 350L380 520M500 350L700 550M500 350L110 590M500 350L850 620M500 350L510 650"/></svg><b>ABY<i></i></b>{tech.map((t,i)=><span style={`--i:${i}`}>{t}<i></i></span>)}</div>
    </section>

    <section class="process scene" data-scene="process">
      <div class="section-head compact"><span class="rail">06 / PROTOCOL</span><div><p class="eyebrow"><i></i>ENGINEERING PROCESS</p><h2>FROM FRICTION<br/>TO <em>FLOW.</em></h2></div></div>
      <ol>{[['01','DISCOVER','Map the real workflow'],['02','ARCHITECT','Design the useful system'],['03','ENGINEER','Build and connect'],['04','EVOLVE','Measure and refine']].map(s=><li><span>{s[0]}</span><i></i><small>{s[1]}</small><h3>{s[2]}</h3><p>Turn ambiguity into a reliable, observable system designed for real use.</p></li>)}</ol>
    </section>

    <section id="contact" class="contact scene" data-scene="contact"><div class="rings"><i></i><i></i><i></i></div><div><p class="eyebrow"><i></i>CONNECTION READY</p><h2>LET’S BUILD<br/>WHAT’S <em>NEXT.</em></h2><p>Interested in AI agents, intelligent automation, production AI products, or open-source collaboration?</p><a class="cta light" href="https://github.com/AmmarBinYasir489" target="_blank" rel="noreferrer">CONNECT ON GITHUB <b>↗</b></a></div></section>
  </main>
  <footer><span>© {new Date().getFullYear()} AMMAR BIN YASIR</span><span>AI AUTOMATION ENGINEER</span><a href="#main">RETURN TO CORE ↑</a></footer>
  <script>import('../scripts/motion').then(({ initMotion }) => initMotion());</script>
</Layout>
